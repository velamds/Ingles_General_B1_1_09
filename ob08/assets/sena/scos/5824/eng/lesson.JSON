"correct": 0, "selected": 0, "_data": [{"content": "We have someone who has lots of experience in the fashion industry.", "type": "text"}], "id": 0}, {"correct": 0, "selected": 0, "_data": [{"content": "If the competitor wins, their business will expand.", "type": "text"}], "id": 1}, {"correct": 1, "selected": 0, "_data": [{"content": "We don't have enough information on the market. The product will not be marketable if we don't know the price range.", "type": "text"}], "id": 2, "text": ""}]}, {"_data": [{"contents": [{"content": "Which of the following is an opportunity?", "type": "text"}], "type": "question"}, {"content": "secondary_1", "type": "objective"}], "id": 2, "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "We have a system in place: set goals, determine strategy, define success.", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "This project could strengthen our position in the market.", "type": "text"}], "id": 1}, {"correct": 0, "selected": 0, "_data": [{"content": "We offer personalized services based on our client's business objectives.", "type": "text"}], "id": 2, "text": ""}]}, {"_data": [{"contents": [{"content": "Which of the following is a threat?", "type": "text"}], "type": "question"}, {"content": "secondary_1", "type": "objective"}], "id": 3, "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "We can get our foot in the door in the Latin American market.", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "If the clothing line doesn't sell, we risk huge financial loss for the client and our firm.", "type": "text"}], "id": 1}, {"correct": 0, "selected": 0, "_data": [{"content": "The product will not be marketable if we don't know the price range.", "type": "text"}], "id": 2, "text": ""}]}], "type": "DMC", "id": 3, "stimuli_ids": []}, {"template_override": 2, "_data": [{"contents": [{"content": " How do we <span class=\"tool-tip\" id=\"tip_4_0\">fare a
ed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}]}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le09ob04re2img05.jpg", "audiosrc": "engenn6le09ob04re2aud01", "images": [{"time": "0", "image": "engenn6le09ob04re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le09ob04re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Receptionist</span>: Mr. Farmani's office. How can I help you? <br/><span class=\"strong\">Peter</span>: Hello, could I speak to Farmani, please? <br/><span class=\"strong\">Receptionist</span>: I'm afraid he's in a meeting until 2 p.m. Can I take a message? <br/><span class=\"strong\">Peter</span>: Well, I'd like to arrange an appointment for Miranda to see him, please. It's Peter Smith here."}, {"time": "15800", "image": "engenn6le09ob04re2img06.jpg", "id": 2, "text": "<span class=\"strong\">Receptionist</span>: Can I put you on hold for a minute, Mr. Smith? I'll just look into the agenda. So when's it convenient for you? <br/><span class=\"strong\">Peter</span>: Is he available next Monday? Let's say around 2 p.m.? <br/><span class=\"strong\">Receptionist</span>: I'm afraid he can't on Monday. What about Tuesday at 2 p.m.? <br/><span class=\"strong\">Peter</span>: Ah, that could be awkward. Tuesday's appointments are rather scattered. Is there any possibility of meeting this Friday? <br/><span class=\"strong\">Receptionist</span>: Well, Friday could work. We keep things rather flexible toward the end of the week. Could she meet at 2 p.m.?"}, {"time": "46000", "image": "engenn6le09ob04re2img07.jpg", "id": 3, "text": "<span class=\"strong\">Peter</span>: Oh dear, she'll be in the middle of her status update meeting. Is there anything available toward the end of the day? <br/><span class=\"strong\">Receptionist</span>: She has her plate full, doesn't she? Let me rearrange a few things ...  Is 4:00 feasible?<br/><span class=\"strong\">Peter</span>: Fantastic."}, {"time": "60200", "image": "engenn6le09ob04re2img07.jpg", "id": 4, "text": "<span class=\"strong\">Receptionist</span>: Alright. So shall we say Friday at 4 p.m. in your company's office? <br/><span class=\"strong\">Peter</span>: Perfect. Thank you for your time. <br/><span class=\"strong\">Receptionist</span>: You're welcome. Good bye."}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}, {"contents": [{"type": "video", "value": {"images": [{"time": "0", "image": "", "id": 0, "text": "Setting Up an Appointment Over the Phone"}], "video_src": "engenn6le09ob04re5vid01"}}], "template_override": 1, "title": "", "type": "video", "id": 2, "_data": []}]}]}